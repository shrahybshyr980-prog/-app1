<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>مطاحن الطيب - نموذج تجريبي</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f5f2;--surf:#fff;--ink:#1d2a30;--mut:#5d6b70;--line:#d5dcd8;--acc:#2b6a4f;--acc-ink:#fff;--gold:#b98a1f;--bad:#a63a2f;--warn:#fff3cf;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#151c1f;--surf:#1e282c;--ink:#e8eeec;--mut:#9aaaa9;--line:#34423f;--acc:#5fb98f;--acc-ink:#0f1b16;--gold:#e0b348;--bad:#e5877c;--warn:#3a3318}}
:root[data-theme="dark"]{--bg:#151c1f;--surf:#1e282c;--ink:#e8eeec;--mut:#9aaaa9;--line:#34423f;--acc:#5fb98f;--acc-ink:#0f1b16;--gold:#e0b348;--bad:#e5877c;--warn:#3a3318}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.6 Cairo,Tahoma,Arial,sans-serif;max-width:760px;margin-inline:auto;padding:0 12px 40px}
header{padding:16px 0 8px}
h1{font-size:22px;font-weight:800;margin:0}
.sub{color:var(--mut);font-size:13px;margin:0}
nav{display:flex;gap:6px;position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);padding:8px 0;z-index:5}
nav button{flex:1;padding:10px 4px;border:1px solid var(--line);background:var(--surf);color:var(--ink);border-radius:8px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
nav button.on{background:var(--acc);color:var(--acc-ink);border-color:var(--acc)}
section{display:none}section.on{display:block}
.card{background:var(--surf);border:1px solid var(--line);border-radius:10px;padding:14px;margin:10px 0}
label{display:block;font-size:13px;color:var(--mut);margin:8px 0 2px}
input,select{width:100%;padding:10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit}
input:focus,select:focus,button:focus-visible{outline:2px solid var(--acc);outline-offset:1px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.btn{padding:11px 16px;border:0;border-radius:8px;background:var(--acc);color:var(--acc-ink);font:inherit;font-weight:700;cursor:pointer}
.btn.alt{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.alt.on{background:var(--acc);color:var(--acc-ink);border-color:var(--acc)}
.btn.sm{padding:5px 10px;font-size:13px}
.tot{font-size:26px;font-weight:800;color:var(--acc)}
.note{background:var(--warn);border-radius:8px;padding:8px 10px;font-size:13px;margin:8px 0}
.err{color:var(--bad);font-size:14px;min-height:22px}
.tag{display:inline-block;font-size:12px;padding:1px 8px;border-radius:99px;border:1px solid var(--line);color:var(--mut)}
.tag.pend{border-color:var(--gold);color:var(--gold)}
.pick{display:flex;justify-content:space-between;gap:8px;padding:10px;border:1px solid var(--line);border-radius:8px;margin:6px 0;cursor:pointer;background:var(--bg)}
.sum{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.sum div{border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:var(--surf)}
.sum b{display:block;font-size:18px}
.scroll{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:14px}
td,th{border:1px solid var(--line);padding:6px 8px;text-align:right}
#modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:20;overflow:auto;padding:16px}
#inv{background:#fff;color:#111;max-width:560px;margin:0 auto;padding:18px;border-radius:8px}
#inv td,#inv th{border-color:#888}
@media (min-width:900px){
body{max-width:1320px;font-size:17px;display:grid;grid-template-columns:230px 1fr;column-gap:24px;align-items:start;padding:0 28px 48px}
header{grid-column:1/-1;padding:22px 0 12px;border-bottom:1px solid var(--line);margin-bottom:12px}
h1{font-size:30px}
nav{grid-column:1;grid-row:2;flex-direction:column;gap:8px;top:calc(env(safe-area-inset-top,0px) + 12px);padding:0}
nav button{text-align:right;font-size:16px;padding:14px 16px}
section{grid-column:2;grid-row:2}
#sale.on{display:grid;grid-template-columns:minmax(300px,1fr) 1.4fr;column-gap:20px;align-items:start}
#sale .card{margin-top:0}
#prices.on{display:grid;grid-template-columns:1fr 1fr;column-gap:20px;align-items:start}
#prices .note{grid-column:1/-1}
#typeBtns{grid-template-columns:repeat(3,1fr)}
#cust .row{grid-template-columns:repeat(2,1fr)}
.sum{grid-template-columns:repeat(3,1fr)}
.sum b{font-size:22px}
td,th{padding:9px 12px}
}
@media (min-width:900px){
#cust>.card:first-child{display:grid;grid-template-columns:260px 1fr;column-gap:24px;align-items:start}
#cust #typeBtns{grid-template-columns:1fr}
#typeBtns button{text-align:right;padding:14px 16px}
#cust #cform .row{grid-template-columns:repeat(2,1fr)}
}
@media print{body>*:not(#modal){display:none!important}#modal{position:static;background:none;padding:0;display:block!important}.noprint{display:none!important}}
</style>
</head>
<body>
<header><h1>مطاحن الطيب</h1></header>
<nav id="nav">
<button data-t="sale" class="on">البيع</button><button data-t="cust">تسجيل زبون</button><button data-t="reg">المسجلون</button><button data-t="prices">الأسعار</button><button data-t="invs">الفواتير</button>
</nav>

<section id="sale" class="on">
<div class="card">
<label>رقم الزبون أو اسمه</label>
<input id="q" placeholder="اكتب الرقم أو الاسم" autocomplete="off">
<div id="results"></div>
<p class="sub" id="emptyHint">ما عندكش زبائن بعد. زِد زبونًا من تبويب الزبائن، أو حمّل البيانات التجريبية.</p>
</div>
<div class="card" id="saleForm" style="display:none">
<div id="cinfo"></div>
<label>المادة</label><select id="prod"></select>
<label>خيار البيع</label><select id="opt"></select>
<div class="row"><div><label id="qlabel">العدد</label><input id="qty" type="number" min="0" step="any" inputmode="decimal"></div>
<div><label>سعر القنطار (من بطاقة الزبون)</label><input id="price" readonly></div></div>
<p>الوزن الإجمالي: <b id="wt">0</b> كغ</p>
<p>الإجمالي: <span class="tot" id="total">0</span> دج</p>
<div class="row"><div><label>طريقة الدفع</label><select id="pay"><option value="cash">نقدي</option><option value="bank">بنكي</option></select></div>
<div><label>المبلغ المدفوع</label><input id="paid" type="number" min="0" step="any" inputmode="decimal"></div></div>
<p>المتبقي (دين): <b id="rest">0</b> دج</p>
<div class="err" id="err"></div>
<button class="btn" id="save">حفظ الفاتورة</button>
</div>
</section>

<section id="cust">
<div class="card">
<div id="typeSide"><b>اختر نوع الزبون</b><div class="row" id="typeBtns" style="margin:8px 0"></div></div>
<div id="cform" style="display:none"><b id="ctitle" style="font-size:18px;display:block">زبون جديد</b>
<div class="card" style="background:var(--bg)"><b>المسجلون في هذا النوع</b> <span class="tag" id="tcount"></span><label>بحث عن زبون (الرقم أو الاسم)</label><input id="tq" autocomplete="off"><div class="scroll" id="tlist"></div></div>
<b>تسجيل زبون جديد من هذا النوع</b>
<div class="row"><div><label>رقم الزبون</label><input id="cnum"></div><div><label>الاسم</label><input id="cname"></div></div>
<div class="row"><div><label>الولاية</label><input id="cwil"></div><div><label>رقم السجل التجاري</label><input id="crc"></div></div>
<label>العنوان</label><input id="cadr">
<div class="row"><div><label>الرقم الجبائي</label><input id="cnif"></div><div><label>الرقم الإحصائي</label><input id="cnis"></div></div>
<div class="row"><div><label>رقم المادة</label><input id="cart"></div><div><label>رقم الهاتف</label><input id="ctel" inputmode="tel"></div></div>
<div id="fcard"><select id="fcat" style="display:none"></select><div class="row" id="fprices"></div></div>
<div id="bcard"><select id="bcat" style="display:none"></select><div class="row" id="bprices"></div></div>
<div class="err" id="cerr"></div>
<button class="btn" id="csave">حفظ الزبون</button>
</div></div>
<div class="note">الأسعار بالدينار للقنطار الواحد (مثل فاتورتكم). أدخلوا أسعاركم الحقيقية، التطبيق ما يفترض أي سعر.</div>
<div class="card"><b>أدوات التجربة</b><br>
<button class="btn alt sm" id="demo">تحميل بيانات تجريبية وهمية</button>
<button class="btn alt sm" id="reset">مسح كل البيانات</button></div>
</section>

<section id="prices">
<div class="note">أسعار كل فئة بالدينار للقنطار. تُستعمل تلقائيًا في البيع لكل زبون من هذه الفئة. إذا كان لزبون معين سعر خاص في بطاقته، فهو يغلب سعر الفئة.</div>
<div class="card"><b>الفرينة</b><div id="pf"></div></div>
<div class="card"><b>النخالة</b><div id="pb"></div></div>
</section>

<section id="reg">
<div class="card"><b>الزبائن المسجلون</b> <span class="tag" id="rcount"></span>
<label>بحث بالرقم أو الاسم</label><input id="rq" autocomplete="off">
<label>الفئة</label><select id="rf"></select>
<div class="scroll" id="clist"></div></div>
</section>

<section id="invs">
<div class="sum" id="sum"></div>
<div class="card"><b>الفواتير</b><div id="ilist"></div></div>
</section>

<div id="modal"><div id="inv"></div>
<p class="noprint" style="text-align:center"><button class="btn" id="doPrint">طباعة</button> <button class="btn alt" id="closeM" style="background:#fff;color:#111">إغلاق</button></p></div>

<script>
const FL={baker_in:{l:'خباز داخل الولاية',s:[50]},trader_in:{l:'تاجر داخل الولاية',s:[10,25,50]},trader_out:{l:'تاجر خارج الولاية',s:[10,25,50]}};
const BR={breeder:'مربي',trader_in:'تاجر داخل الولاية',trader_out:'تاجر خارج الولاية'};
const $=id=>document.getElementById(id);
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fmt=n=>(Math.round(n*100)/100).toLocaleString('fr-FR');
let db={customers:[],invoices:[],seq:0},cur=null;
try{const r=localStorage.getItem('mt_db');if(r)db=JSON.parse(r)}catch(e){}
function persist(){try{localStorage.setItem('mt_db',JSON.stringify(db))}catch(e){}}

document.querySelectorAll('#nav button').forEach(b=>b.onclick=()=>{
 document.querySelectorAll('#nav button').forEach(x=>x.classList.toggle('on',x===b));
 document.querySelectorAll('section').forEach(s=>s.classList.toggle('on',s.id===b.dataset.t));
 renderAll();
});

const P=()=>db.prices||(db.prices={f:{},b:{}});
const fPrice=(c,s)=>(c.flour.p[s])||((P().f[c.flour.cat]||{})[s])||0;
const bPrice=(c,k)=>(c.bran.p[k])||((P().b[c.bran.cat]||{})[k])||0;
function renderPrices(){
 $('pf').innerHTML=Object.entries(FL).map(([k,v])=>`<p style="margin:8px 0 0"><b>${v.l}</b></p><div class="row">${v.s.map(s=>`<div><label>أكياس ${s} كغ</label><input data-k="f|${k}|${s}" type="number" min="0" step="any" inputmode="decimal" value="${(P().f[k]||{})[s]||''}"></div>`).join('')}</div>`).join('');
 $('pb').innerHTML=Object.entries(BR).map(([k,v])=>`<p style="margin:8px 0 0"><b>${v}</b></p><div class="row"><div><label>أكياس 25 كغ</label><input data-k="b|${k}|bag25" type="number" min="0" step="any" inputmode="decimal" value="${(P().b[k]||{}).bag25||''}"></div><div><label>بدون أكياس</label><input data-k="b|${k}|loose" type="number" min="0" step="any" inputmode="decimal" value="${(P().b[k]||{}).loose||''}"></div></div>`).join('');
 $('prices').oninput=e=>{const t=e.target;if(!t.dataset.k)return;const[a,cat,key]=t.dataset.k.split('|');const o=P()[a];o[cat]=o[cat]||{};o[cat][key]=parseFloat(t.value)||0;persist()};
}
/* ---------- customers ---------- */
function fForm(){
 $('fcat').innerHTML='<option value="">غير مسجل في الفرينة</option>'+Object.entries(FL).map(([k,v])=>`<option value="${k}">${v.l}</option>`).join('');fPrices();
}
function fPrices(){
 $('fprices').innerHTML=!$('fcat').value?'':FL[$('fcat').value].s.map(s=>`<div><label>سعر خاص للقنطار: أكياس ${s} كغ (اتركه فارغًا لسعر الفئة)</label><input data-fs="${s}" placeholder="${fmt(((P().f[$('fcat').value]||{})[s])||0)}" type="number" min="0" step="any" inputmode="decimal"></div>`).join('');
}
function bForm(){
 $('bcat').innerHTML='<option value="">غير مسجل في النخالة</option>'+Object.entries(BR).map(([k,v])=>`<option value="${k}">${v}</option>`).join('');bPrices();}
function bPrices(){
 $('bprices').innerHTML=!$('bcat').value?'':`<div><label>سعر خاص: أكياس 25 كغ (اتركه فارغًا لسعر الفئة)</label><input id="bp25" placeholder="${fmt(((P().b[$('bcat').value]||{}).bag25)||0)}" type="number" min="0" step="any" inputmode="decimal"></div><div><label>سعر خاص: بدون أكياس (اتركه فارغًا لسعر الفئة)</label><input id="bploose" placeholder="${fmt(((P().b[$('bcat').value]||{}).loose)||0)}" type="number" min="0" step="any" inputmode="decimal"></div>`;
}
$('fcat').onchange=fPrices;$('bcat').onchange=bPrices;
const TYPES=[...Object.entries(FL).map(([k,v])=>['f',k,'فرينة: '+v.l]),...Object.entries(BR).map(([k,v])=>['b',k,'نخالة: '+v])];
$('typeBtns').innerHTML=TYPES.map((t,i)=>`<button class="btn alt" data-i="${i}">${t[2]}</button>`).join('');
$('typeBtns').onclick=e=>{const b=e.target.closest('button');if(!b)return;const t=TYPES[b.dataset.i];fForm();bForm();
 if(t[0]==='f'){$('fcat').value=t[1];fPrices()}else{$('bcat').value=t[1];bPrices()}
 $('cform').style.display='block';$('ctitle').textContent='تسجيل زبون - '+t[2];
 document.querySelectorAll('#typeBtns button').forEach(x=>x.classList.toggle('on',x===b));$('tq').value='';renderTypeList()};
$('csave').onclick=()=>{
 const num=$('cnum').value.trim(),name=$('cname').value.trim();
 if(!num||!name){$('cerr').textContent='رقم الزبون والاسم مطلوبان.';return}
 const ex=db.customers.find(c=>c.num===num);
 if(!$('fcat').value&&!$('bcat').value){$('cerr').textContent='اختر نوع الزبون أولًا.';return}
 const c={num,name,wil:$('cwil').value.trim(),rc:$('crc').value.trim(),adr:$('cadr').value.trim(),nif:$('cnif').value.trim(),nis:$('cnis').value.trim(),art:$('cart').value.trim(),tel:$('ctel').value.trim(),flour:null,bran:null};
 if($('fcat').value){const p={};document.querySelectorAll('[data-fs]').forEach(i=>p[i.dataset.fs]=parseFloat(i.value)||0);c.flour={cat:$('fcat').value,p}}
 if($('bcat').value){c.bran={cat:$('bcat').value,p:{bag25:parseFloat($('bp25').value)||0,loose:parseFloat($('bploose').value)||0}}}
 if(ex){if((c.flour&&ex.flour)||(c.bran&&ex.bran)){$('cerr').textContent='هذا الرقم مسجل من قبل في نفس المادة.';return}if(c.flour)ex.flour=c.flour;if(c.bran)ex.bran=c.bran}else db.customers.push(c);persist();$('cerr').textContent='';
 ['cnum','cname','cwil','crc','cadr','cnif','cnis','cart','ctel'].forEach(i=>$(i).value='');fForm();bForm();renderAll();$('cform').style.display='none';document.querySelectorAll('#typeBtns button').forEach(x=>x.classList.remove('on'));document.querySelector('[data-t="reg"]').click();
};
$('demo').onclick=()=>{
 const d=[{num:'D-001',name:'زبون تجريبي (خباز)',wil:'الوادي',adr:'عنوان وهمي',rc:'',flour:{cat:'baker_in',p:{50:1000}},bran:null},
 {num:'D-002',name:'زبون تجريبي (تاجر داخل الولاية)',wil:'الوادي',adr:'عنوان وهمي',rc:'',flour:{cat:'trader_in',p:{10:1100,25:1100,50:1100}},bran:{cat:'trader_in',p:{bag25:500,loose:400}}},
 {num:'D-003',name:'زبون تجريبي (مربي)',wil:'الوادي',adr:'عنوان وهمي',rc:'',flour:null,bran:{cat:'breeder',p:{bag25:500,loose:400}}}];
 d.forEach(x=>{if(!db.customers.some(c=>c.num===x.num))db.customers.push(x)});persist();renderAll();
};
$('reset').onclick=()=>{if(confirm('مسح كل الزبائن والفواتير؟')){db={customers:[],invoices:[],seq:0,prices:{f:{},b:{}}};cur=null;persist();$('saleForm').style.display='none';renderAll()}};
function renderCust(){
 const f=$('rf');
 if(!f.options.length)f.innerHTML='<option value="">كل الفئات</option><option value="F">كل زبائن الفرينة</option>'+Object.entries(FL).map(([k,v])=>`<option value="f:${k}">فرينة - ${v.l}</option>`).join('')+'<option value="B">كل زبائن النخالة</option>'+Object.entries(BR).map(([k,v])=>`<option value="b:${k}">نخالة - ${v}</option>`).join('');
 $('rq').oninput=renderCust;f.onchange=renderCust;
 const q=$('rq').value.trim().toLowerCase(),fv=f.value;
 const r=db.customers.filter(c=>(!q||c.num.toLowerCase().includes(q)||c.name.toLowerCase().includes(q))&&(!fv||(fv==='F'?c.flour:fv==='B'?c.bran:fv[0]==='f'?(c.flour&&c.flour.cat===fv.slice(2)):(c.bran&&c.bran.cat===fv.slice(2)))));
 $('rcount').textContent=r.length+' من '+db.customers.length;
 const fp=c=>c.flour?'<b>'+FL[c.flour.cat].l+'</b><br>'+FL[c.flour.cat].s.map(s=>s+' كغ: '+fmt(fPrice(c,s))).join(' | '):'-';
 const bp=c=>c.bran?'<b>'+BR[c.bran.cat]+'</b><br>25 كغ: '+fmt(bPrice(c,'bag25'))+' | سائب: '+fmt(bPrice(c,'loose')):'-';
 $('clist').innerHTML=r.length?'<table><tr><th>الرقم</th><th>الاسم</th><th>الولاية</th><th>بيانات الزبون</th><th>الفرينة (سعر القنطار)</th><th>النخالة (سعر القنطار)</th></tr>'+r.map(c=>`<tr><td>${esc(c.num)}</td><td>${esc(c.name)}</td><td>${esc(c.wil)}</td><td>${esc(c.adr)}${c.rc?'<br>س.ت: '+esc(c.rc):''}${c.nif?'<br>ر.ج: '+esc(c.nif):''}${c.nis?'<br>ر.إ: '+esc(c.nis):''}${c.art?'<br>م: '+esc(c.art):''}${c.tel?'<br>هـ: '+esc(c.tel):''}</td><td>${fp(c)}</td><td>${bp(c)}</td></tr>`).join('')+'</table>':'<p class="sub">لا يوجد زبائن مطابقون.</p>';
}

function renderTypeList(){
 const fc=$('fcat').value,bc=$('bcat').value;if(!fc&&!bc){$('tlist').innerHTML='';return}
 const q=$('tq').value.trim().toLowerCase();
 const r=db.customers.filter(c=>(fc?(c.flour&&c.flour.cat===fc):(c.bran&&c.bran.cat===bc))&&(!q||c.num.toLowerCase().includes(q)||c.name.toLowerCase().includes(q)));
 const pr=c=>fc?FL[fc].s.map(s=>s+' كغ: '+fmt(fPrice(c,s))).join(' | '):'25 كغ: '+fmt(bPrice(c,'bag25'))+' | سائب: '+fmt(bPrice(c,'loose'));
 $('tcount').textContent=r.length;
 $('tlist').innerHTML=r.length?'<table><tr><th>الرقم</th><th>الاسم</th><th>الولاية</th><th>الأسعار (للقنطار)</th></tr>'+r.map(c=>`<tr><td>${esc(c.num)}</td><td>${esc(c.name)}</td><td>${esc(c.wil)}</td><td>${pr(c)}</td></tr>`).join('')+'</table>':'<p class="sub">لا يوجد زبائن مسجلون في هذا النوع بعد.</p>';
}
$('tq').oninput=renderTypeList;
/* ---------- sale ---------- */
function renderResults(){
 const q=$('q').value.trim().toLowerCase();$('emptyHint').style.display=db.customers.length?'none':'block';
 const r=q?db.customers.filter(c=>c.num.toLowerCase().includes(q)||c.name.toLowerCase().includes(q)).slice(0,6):[];
 $('results').innerHTML=r.map(c=>`<div class="pick" data-n="${esc(c.num)}"><span><b>${esc(c.num)}</b> ${esc(c.name)}</span></div>`).join('');
 $('results').querySelectorAll('.pick').forEach(p=>p.onclick=()=>pickCust(p.dataset.n));
 const ex=db.customers.find(c=>c.num.toLowerCase()===q);if(ex&&(!cur||cur.num!==ex.num))pickCust(ex.num);
}
$('q').oninput=renderResults;
function pickCust(n){
 cur=db.customers.find(c=>c.num===n);$('results').innerHTML='';$('saleForm').style.display='block';
 $('cinfo').innerHTML=`<b>${esc(cur.name)}</b> <span class="tag">${esc(cur.num)}</span><br><span class="sub">${esc(cur.wil)} ${esc(cur.adr)}</span><br>${cur.flour?'<span class="tag">فرينة: '+FL[cur.flour.cat].l+'</span> ':''}${cur.bran?'<span class="tag">نخالة: '+BR[cur.bran.cat]+'</span>':''}`;
 $('prod').innerHTML=(cur.flour?'<option value="flour">فرينة</option>':'')+(cur.bran?'<option value="bran">نخالة</option>':'');
 prodChange();
}
function prodChange(){
 const p=$('prod').value;
 $('opt').innerHTML=p==='flour'?FL[cur.flour.cat].s.map(s=>`<option value="${s}">أكياس ${s} كغ</option>`).join(''):'<option value="bag25">أكياس 25 كغ</option><option value="loose">بدون أكياس (بالكيلوغرام)</option>';
 calc(true);
}
$('prod').onchange=prodChange;$('opt').onchange=()=>calc(true);
function line(){
 const p=$('prod').value,o=$('opt').value,q=parseFloat($('qty').value)||0;
 let kg,price,unit;
 if(p==='flour'){kg=q*parseFloat(o);price=fPrice(cur,o);unit='أكياس '+o+' كغ'}
 else if(o==='bag25'){kg=q*25;price=bPrice(cur,'bag25');unit='أكياس 25 كغ'}
 else{kg=q;price=bPrice(cur,'loose');unit='بدون أكياس'}
 return{p,o,q,kg,price,unit,amount:kg/100*price};
}
function calc(reset){
 if(!cur)return;const l=line(),loose=$('opt').value==='loose'&&$('prod').value==='bran';
 $('qlabel').textContent=loose?'الكمية بالكيلوغرام':'عدد الأكياس';
 $('price').value=l.price?fmt(l.price):'غير مسجل';$('wt').textContent=fmt(l.kg);$('total').textContent=fmt(l.amount);
 if(reset)$('paid').value=l.amount||'';
 const paid=parseFloat($('paid').value)||0;$('rest').textContent=fmt(Math.max(0,l.amount-paid));
}
$('qty').oninput=()=>calc(true);$('paid').oninput=()=>calc(false);
$('save').onclick=()=>{
 const l=line(),paid=parseFloat($('paid').value)||0;
 if(!l.q||l.q<=0){$('err').textContent='أدخل الكمية.';return}
 if(!l.price){$('err').textContent='سعر هذا الخيار غير مسجل في بطاقة الزبون.';return}
 if(paid>l.amount+0.001){$('err').textContent='المبلغ المدفوع أكبر من الإجمالي.';return}
 db.seq++;const d=new Date(),no=d.getFullYear()+'/'+String(db.seq).padStart(4,'0');
 const inv={no,at:d.toISOString(),c:{num:cur.num,name:cur.name,wil:cur.wil,adr:cur.adr,rc:cur.rc,nif:cur.nif,nis:cur.nis,art:cur.art},prod:l.p==='flour'?'فرينة':'نخالة',unit:l.unit,qty:l.q,loose:l.unit==='بدون أكياس',kg:l.kg,price:l.price,amount:l.amount,paid,method:$('pay').value,bank:$('pay').value==='bank'?'pending':null};
 db.invoices.unshift(inv);persist();$('err').textContent='';$('qty').value='';$('paid').value='';calc(true);showInv(inv);
};

/* ---------- invoices ---------- */
function showInv(i){
 const d=new Date(i.at);
 $('inv').innerHTML=`<h2 style="margin:0;text-align:center">مطاحن الطيب</h2><p style="text-align:center;margin:0">حي الشرقية، حاسي خليفة، ولاية الوادي</p><hr>
 <p>فاتورة رقم: <b>${i.no}</b><br>التاريخ: ${d.toLocaleDateString('fr-FR')} ${d.toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'})}<br>الزبون: <b>${esc(i.c.name)}</b> (رمز: ${esc(i.c.num)})<br>${esc(i.c.wil)} ${esc(i.c.adr)}${i.c.rc?'<br>السجل التجاري: '+esc(i.c.rc):''}${i.c.nif?'<br>الرقم الجبائي: '+esc(i.c.nif):''}${i.c.nis?'<br>الرقم الإحصائي: '+esc(i.c.nis):''}${i.c.art?'<br>رقم المادة: '+esc(i.c.art):''}</p>
 <div class="scroll"><table><tr><th>التعيين</th><th>${i.loose?'الكمية (كغ)':'عدد الأكياس'}</th><th>الوزن (كغ)</th><th>سعر القنطار</th><th>المبلغ</th></tr>
 <tr><td>${i.prod} - ${esc(i.unit)}</td><td>${fmt(i.qty)}</td><td>${fmt(i.kg)}</td><td>${fmt(i.price)}</td><td>${fmt(i.amount)}</td></tr></table></div>
 <p>الإجمالي: <b>${fmt(i.amount)} دج</b><br>المدفوع: ${fmt(i.paid)} دج<br>المتبقي: ${fmt(i.amount-i.paid)} دج<br>طريقة الدفع: ${i.method==='cash'?'نقدي':'بنكي'}${i.bank==='pending'?' (في انتظار التأكيد)':''}</p>
 <p style="color:#a00;font-size:12px">نموذج تجريبي: التنسيق النهائي سيطابق فاتورتكم الأصلية.</p>`;
 $('modal').style.display='block';
}
$('closeM').onclick=()=>$('modal').style.display='none';
$('doPrint').onclick=()=>{try{window.print()}catch(e){}};
function renderInvs(){
 const t=new Date().toDateString(),today=db.invoices.filter(i=>new Date(i.at).toDateString()===t);
 const cash=db.invoices.filter(i=>i.method==='cash').reduce((a,i)=>a+i.paid,0);
 const bankOk=db.invoices.filter(i=>i.bank==='confirmed').reduce((a,i)=>a+i.paid,0);
 const pend=db.invoices.filter(i=>i.bank==='pending').reduce((a,i)=>a+i.paid,0);
 const debt=db.invoices.reduce((a,i)=>a+(i.amount-i.paid),0);
 $('sum').innerHTML=`<div>مبيعات اليوم<b>${fmt(today.reduce((a,i)=>a+i.amount,0))} دج</b></div><div>عدد فواتير اليوم<b>${today.length}</b></div><div>رصيد الصندوق<b>${fmt(cash)} دج</b></div><div>بنك مؤكد<b>${fmt(bankOk)} دج</b></div><div>بنك في الانتظار<b>${fmt(pend)} دج</b></div><div>ديون الزبائن<b>${fmt(debt)} دج</b></div>`;
 $('ilist').innerHTML=db.invoices.length?db.invoices.map((i,k)=>`<div class="pick" style="cursor:default"><span><b>${i.no}</b> ${esc(i.c.name)}<br><span class="sub">${i.prod} - ${fmt(i.amount)} دج</span></span><span>${i.bank==='pending'?'<span class="tag pend">بنك: في الانتظار</span> <button class="btn sm" data-ok="${k}">تأكيد وصول المبلغ</button> ':i.bank==='confirmed'?'<span class="tag">بنك: مؤكد</span> ':''}<button class="btn alt sm" data-pr="${k}">عرض / إعادة طباعة</button></span></div>`).join(''):'<p class="sub">لا توجد فواتير بعد.</p>';
 $('ilist').querySelectorAll('[data-pr]').forEach(b=>b.onclick=()=>showInv(db.invoices[b.dataset.pr]));
 $('ilist').querySelectorAll('[data-ok]').forEach(b=>b.onclick=()=>{db.invoices[b.dataset.ok].bank='confirmed';persist();renderInvs()});
}
function renderAll(){renderCust();renderResults();renderInvs();renderPrices();renderTypeList()}
fForm();bForm();renderAll();
</script>
</body>
</html>
